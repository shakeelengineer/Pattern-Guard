{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "▶ Run Extension (Empty Window)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--new-window",
        "--disable-extensions"
      ],
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "preLaunchTask": "npm: compile",
      "sourceMaps": true,
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "▶ Run Extension (Test Workspace)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--new-window",
        "--disable-extensions",
        "${workspaceFolder}/test-workspace"
      ],
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "preLaunchTask": "npm: compile",
      "sourceMaps": true,
      "internalConsoleOptions": "neverOpen"
    }
  ]
}
